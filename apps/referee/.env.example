# --- bmb-victim (the backend that gets broken) ---
# Base URL and keys come from `npx @insforge/cli local status --show-keys --json` (local)
# or from victim/.insforge/project.json + `npx @insforge/cli secrets get ANON_KEY` (cloud).
VICTIM_URL=https://<appkey>.us-east.insforge.app
VICTIM_ANON_KEY=anon_...
VICTIM_API_KEY=ik_...            # admin key, referee only — the healer never sees it
VICTIM_DIR=../../victim          # the InsForge-linked directory every healer tool runs in

# Deterministic probe user (created by the seed step, Phase 1)
PROBE_EMAIL=probe@bmb.local
PROBE_PASSWORD=change-me-probe-password
FILLER_EMAIL=filler@bmb.local
FILLER_PASSWORD=change-me-filler-password

# --- bmb-control (rounds, events, scores; Phase 5) ---
CONTROL_URL=https://<appkey>.us-east.insforge.app
CONTROL_API_KEY=ik_...

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
HEALER_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-sonnet-5

# Filler volume and the P2 latency limit. 400k rows makes a dropped index cost ~600 ms on a nano
# instance; keep P2_MAX_MS=400 when the referee runs next to the DB (prod), raise it for far-away dev.
FILLER_NOTES=400000
P2_MAX_MS=400

# --- Model provider (default anthropic). Free-tier alternative: Groq or OpenRouter.
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# HEALER_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b   # fallbacks when a daily quota is spent
# JUDGE_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
# HEALER_SKILL_REFERENCES=0      # keep the H2 prompt small on free token caps
# SELF_PLAY_EVERY_MIN=720        # free tiers: keep the daily budget for visitors
