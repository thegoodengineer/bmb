# bmb-control ANON key only. The web app never holds a service/admin key.
NEXT_PUBLIC_CONTROL_URL=https://<appkey>.us-east.insforge.app
NEXT_PUBLIC_CONTROL_ANON_KEY=anon_...

# Server-side secret used to sign the anonymous attacker session cookie.
ATTACKER_SESSION_SECRET=change-me-32-random-bytes

# Optional: the referee's public URL. Accepted attacks ping it so a stopped machine starts.
REFEREE_URL=https://<referee-service>.fly.dev
