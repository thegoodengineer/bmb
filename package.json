  "description": "A public, live, adversarial mini-benchmark for agent-native backends, built on InsForge.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
